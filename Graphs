        // using set
        set<pair<int,int>>st;
        vector<int>dist(V,1e9);
        
        st.insert({0,src});
        dist[src]=0;
        
        while(!st.empty()){
            auto it=*(st.begin());
            int d=it.first;
            int node=it.second;
            st.erase(it);
            
            
            for(auto i:adj[node]){
                int adjnode=i.first;
                int egwt=i.second;
                
                if(dist[adjnode]>d+egwt){
                    if(dist[adjnode]!=1e9){
                        st.erase({dist[adjnode],adjnode});
                    }
                        dist[adjnode]=d+egwt;
                        st.insert({dist[adjnode],adjnode});
                    
                }
            }
        }
        
        return dist;

